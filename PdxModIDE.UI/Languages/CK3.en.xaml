<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--
        Language dictionary specific to CK3: English (en)
        CK3-specific strings (modules, UI, etc.).
        General application strings are in en.xaml.
        To add a new game, create {GameKey}.en.xaml.
    -->

    <!-- CulturesTab: ethos parameter explanations -->
    <system:String x:Key="EthosParam_character_modifier_Desc">Modifiers applied to characters of this culture.</system:String>
    <system:String x:Key="EthosParam_province_modifier_Desc">Modifiers applied to provinces belonging to this culture.</system:String>
    <system:String x:Key="EthosParam_county_modifier_Desc">Modifiers applied to counties of this culture.</system:String>
    <system:String x:Key="EthosParam_culture_modifier_Desc">Modifiers applied at the culture level.</system:String>
    <system:String x:Key="EthosParam_parameters_Desc">Special flags that enable specific behaviors of this ethos.</system:String>
    <system:String x:Key="EthosParam_ai_will_do_Desc">Scripted weight that determines how likely the AI is to adopt this ethos.</system:String>
    <system:String x:Key="EthosParam_desc_Desc">Localization key of the ethos description text.</system:String>

    <!-- CulturesTab: heritage parameter explanations -->
    <system:String x:Key="HeritageParam_is_shown_Desc">Conditions that determine when this heritage is shown.</system:String>
    <system:String x:Key="HeritageParam_audio_parameter_Desc">Audio parameter associated with this heritage.</system:String>

    <!-- CulturesTab: language parameter explanations -->
    <system:String x:Key="LanguageParam_is_shown_Desc">Conditions that determine when this language is shown.</system:String>
    <system:String x:Key="LanguageParam_ai_will_do_Desc">Scripted weight that determines how likely the AI is to adopt this language.</system:String>
    <system:String x:Key="LanguageParam_color_Desc">Color reference associated with this language.</system:String>

    <!-- CulturesTab: martial custom parameter explanations -->
    <system:String x:Key="MartialCustomParam_parameters_Desc">Special flags that enable specific behaviors of this martial custom.</system:String>
    <system:String x:Key="MartialCustomParam_can_pick_Desc">Conditions that determine when this martial custom can be picked.</system:String>
    <system:String x:Key="MartialCustomParam_ai_will_do_Desc">Scripted weight that determines how likely the AI is to adopt this martial custom.</system:String>

    <!-- CulturesTab: head determination parameter explanations -->
    <system:String x:Key="HeadDeterminationParam_head_determination_type_Desc">How the cultural head is determined.</system:String>

    <!-- CulturesTab: tradition parameter explanations -->
    <system:String x:Key="TraditionParam_category_Desc">Category this tradition belongs to.</system:String>
    <system:String x:Key="TraditionParam_layers_Desc">Visual layers used to render the tradition icon.</system:String>
    <system:String x:Key="TraditionParam_can_pick_Desc">Conditions that determine whether this tradition can be picked.</system:String>
    <system:String x:Key="TraditionParam_can_pick_for_hybridization_Desc">Conditions that determine whether this tradition can be picked when hybridizing cultures.</system:String>
    <system:String x:Key="TraditionParam_parameters_Desc">Special flags that enable specific behaviors of this tradition.</system:String>
    <system:String x:Key="TraditionParam_character_modifier_Desc">Modifiers applied to characters of this culture.</system:String>
    <system:String x:Key="TraditionParam_province_modifier_Desc">Modifiers applied to provinces of this culture.</system:String>
    <system:String x:Key="TraditionParam_county_modifier_Desc">Modifiers applied to counties of this culture.</system:String>
    <system:String x:Key="TraditionParam_culture_modifier_Desc">Modifiers applied at the culture level.</system:String>
    <system:String x:Key="TraditionParam_effects_Desc">Effects applied when adopting this tradition.</system:String>
    <system:String x:Key="TraditionParam_cost_Desc">Prestige cost required to adopt this tradition.</system:String>
    <system:String x:Key="TraditionParam_ai_will_do_Desc">Scripted weight that determines how likely the AI is to adopt this tradition.</system:String>
    <system:String x:Key="TraditionParam_desc_Desc">Localization key of the tradition description text.</system:String>

</ResourceDictionary>
