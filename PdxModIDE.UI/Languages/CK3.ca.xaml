<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--
        Diccionari d'idioma específic de CK3: Català (ca)
        Textos propis del joc CK3 (mòduls, UI específica, etc.).
        Els textos generals de l'aplicació són a ca.xaml.
        Per afegir un nou joc, crear {GameKey}.ca.xaml.
    -->

    <!-- CulturesTab: explicacions dels paràmetres de l'ethos -->
    <system:String x:Key="EthosParam_character_modifier_Desc">Modificadors que s'apliquen als personatges d'aquesta cultura.</system:String>
    <system:String x:Key="EthosParam_province_modifier_Desc">Modificadors que s'apliquen a les províncies d'aquesta cultura.</system:String>
    <system:String x:Key="EthosParam_county_modifier_Desc">Modificadors que s'apliquen als comtats d'aquesta cultura.</system:String>
    <system:String x:Key="EthosParam_culture_modifier_Desc">Modificadors que s'apliquen a nivell de cultura.</system:String>
    <system:String x:Key="EthosParam_parameters_Desc">Indicadors especials que activen comportaments concrets d'aquest ethos.</system:String>
    <system:String x:Key="EthosParam_ai_will_do_Desc">Pes guionitzat que determina la probabilitat que la IA adopti aquest ethos.</system:String>
    <system:String x:Key="EthosParam_desc_Desc">Clau de localització del text de descripció de l'ethos.</system:String>

    <!-- CulturesTab: explicacions dels paràmetres de la herència -->
    <system:String x:Key="HeritageParam_is_shown_Desc">Condicions que determinen quan es mostra aquesta herència.</system:String>
    <system:String x:Key="HeritageParam_audio_parameter_Desc">Paràmetre d'àudio associat a aquesta herència.</system:String>

    <!-- CulturesTab: explicacions dels paràmetres de l'idioma -->
    <system:String x:Key="LanguageParam_is_shown_Desc">Condicions que determinen quan es mostra aquest idioma.</system:String>
    <system:String x:Key="LanguageParam_ai_will_do_Desc">Pes guionitzat que determina la probabilitat que la IA adopti aquest idioma.</system:String>
    <system:String x:Key="LanguageParam_color_Desc">Referència de color associada a aquest idioma.</system:String>

    <!-- CulturesTab: explicacions dels paràmetres de la tradició marcial -->
    <system:String x:Key="MartialCustomParam_parameters_Desc">Indicadors especials que activen comportaments concrets d'aquesta tradició marcial.</system:String>
    <system:String x:Key="MartialCustomParam_can_pick_Desc">Condicions que determinen quan es pot triar aquesta tradició marcial.</system:String>
    <system:String x:Key="MartialCustomParam_ai_will_do_Desc">Pes guionitzat que determina la probabilitat que la IA adopti aquesta tradició marcial.</system:String>

    <!-- CulturesTab: explicacions dels paràmetres de la designació del líder -->
    <system:String x:Key="HeadDeterminationParam_head_determination_type_Desc">Com es determina el líder cultural.</system:String>

</ResourceDictionary>
