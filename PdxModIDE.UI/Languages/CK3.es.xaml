    <system:String x:Key="LanguageParam_color_Desc">Referencia de color asociada a este idioma.</system:String>

    <!-- CulturesTab: explicaciones de los parámetros de la tradición marcial -->
    <system:String x:Key="MartialCustomParam_parameters_Desc">Indicadores especiales que activan comportamientos concretos de esta tradición marcial.</system:String>
    <system:String x:Key="MartialCustomParam_can_pick_Desc">Condiciones que determinan cuándo se puede elegir esta tradición marcial.</system:String>
    <system:String x:Key="MartialCustomParam_ai_will_do_Desc">Peso guionizado que determina la probabilidad de que la IA adopte esta tradición marcial.</system:String>

