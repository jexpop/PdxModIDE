<UserControl x:Class="PdxModIDE.UI.ProfileTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <Style x:Key="ModifiedTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="{DynamicResource ProfileTab_SelectProfile}" FontWeight="Bold" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding Profiles}" 
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding CurrentProfile, Mode=TwoWay}"
                      Margin="0,0,0,10"/>

            <GroupBox Header="{DynamicResource ProfileTab_Routes}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ProfileTab_GameRoot}" Margin="0,5,0,0"/>
                    <DockPanel Margin="0,2,0,5">
                        <Button Content="{DynamicResource ProfileTab_Browse}" Width="80" 
                                Command="{Binding BrowseGameRootCommand}"
                                DockPanel.Dock="Right" Margin="5,0,0,0"/>
                        <TextBox Text="{Binding GameRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding GameRootModified, Mode=OneWay}"
                                 Style="{StaticResource ModifiedTextBox}"/>
                    </DockPanel>

                    <TextBlock Text="{DynamicResource ProfileTab_ModRoot}" Margin="0,5,0,0"/>
                    <DockPanel Margin="0,2,0,5">
                        <Button Content="{DynamicResource ProfileTab_Browse}" Width="80" 
                                Command="{Binding BrowseModRootCommand}"
                                DockPanel.Dock="Right" Margin="5,0,0,0"/>
                        <TextBox Text="{Binding ModRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding ModRootModified, Mode=OneWay}"
                                 Style="{StaticResource ModifiedTextBox}"/>
                    </DockPanel>

                    <TextBlock Text="{DynamicResource ProfileTab_BackupRoot}" Margin="0,5,0,0"/>
                    <DockPanel Margin="0,2,0,5">
                        <Button Content="{DynamicResource ProfileTab_Browse}" Width="80" 
                                Command="{Binding BrowseBackupRootCommand}"
                                DockPanel.Dock="Right" Margin="5,0,0,0"/>
                        <TextBox Text="{Binding BackupRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding BackupRootModified, Mode=OneWay}"
                                 Style="{StaticResource ModifiedTextBox}"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource ProfileTab_FileNameConventions}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{DynamicResource ProfileTab_FileNameConventionsInfo}" TextWrapping="Wrap" Foreground="Gray" Margin="0,5,0,5"/>
                    <TextBlock Text="{DynamicResource ProfileTab_CultureFileNamePrefix}" Margin="0,5,0,0"/>
                    <DockPanel Margin="0,2,0,5">
                        <TextBox Text="{Binding CultureFileNamePrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding CultureFileNamePrefixModified, Mode=OneWay}"
                                 Width="200" MaxLength="50" HorizontalAlignment="Left"
                                 DockPanel.Dock="Left"
                                 Style="{StaticResource ModifiedTextBox}"/>
                        <TextBlock Text="{Binding CultureFileNamePreview}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" Foreground="Gray"/>
                    </DockPanel>
                    <TextBlock Text="{DynamicResource ProfileTab_HeritageFileName}" Margin="0,5,0,0"/>
                    <DockPanel Margin="0,2,0,5">
                        <TextBox Text="{Binding HeritageFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="{Binding HeritageFileNameModified, Mode=OneWay}"
                                 Width="200" MaxLength="80" HorizontalAlignment="Left"
                                 DockPanel.Dock="Left"
                                 Style="{StaticResource ModifiedTextBox}"/>
                        <TextBlock Text="{Binding HeritageFileNamePreview}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" Foreground="Gray"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="{DynamicResource ProfileTab_SaveProfile}" Width="120" Margin="0,0,10,0" 
                        Command="{Binding SaveProfileCommand}"/>
                <Button Content="{DynamicResource ProfileTab_NewProfile}" Width="120" Margin="0,0,10,0"
                        Command="{Binding CreateProfileCommand}"/>
                <Button Content="{DynamicResource ProfileTab_RenameProfile}" Width="120" Margin="0,0,10,0"
                        Command="{Binding RenameProfileCommand}"/>
                <Button Content="{DynamicResource ProfileTab_DeleteProfile}" Width="120"
                        Command="{Binding DeleteProfileCommand}"/>
            </StackPanel>

            <TextBlock Text="{Binding ProfileStatusMessage}" Foreground="{DynamicResource StatusGreen}"
                       Margin="0,0,0,10" TextWrapping="Wrap"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>