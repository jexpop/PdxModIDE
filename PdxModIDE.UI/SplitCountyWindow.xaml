<Window x:Class="PdxModIDE.UI.SplitCountyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="{DynamicResource SplitCounty_Title}"
        Height="300" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListView x:Name="CountyList" Grid.Row="0"
                  Background="{DynamicResource ListViewBackground}"
                  Foreground="{DynamicResource ListViewForeground}"
                  BorderBrush="{DynamicResource ControlBorder}"
                  BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Province ID" Width="100"
                                    DisplayMemberBinding="{Binding ProvinceId}"/>
                    <GridViewColumn Header="{DynamicResource SplitCounty_BaronyCol}" Width="150"
                                    DisplayMemberBinding="{Binding BaronyKey}"/>
                    <GridViewColumn Header="{DynamicResource SplitCounty_CountyCol}" Width="150"
                                    DisplayMemberBinding="{Binding CountyKey}"/>
                    <GridViewColumn Header="{DynamicResource SplitCounty_ParentCol}" Width="150"
                                    DisplayMemberBinding="{Binding ParentTitle}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnClose" Content="{DynamicResource SplitCounty_Close}"
                    Width="90" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
