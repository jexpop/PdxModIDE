<UserControl x:Class="PdxModIDE.UI.CulturesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PdxModIDE.UI"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <Style x:Key="ModifiedEditorLabel" TargetType="Label">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource StatusRed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModifiedEditorCombo" TargetType="ComboBox">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusRed}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <TabControl x:Name="CulturesSubTabs">
        <TabItem x:Name="ListTabItem" Header="{DynamicResource CulturesTab_SubTabList}">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TreeView x:Name="CultureTree" Grid.Row="1"
                      SelectedItemChanged="CultureTree_SelectedItemChanged"
                      PreviewMouseRightButtonDown="CultureTree_PreviewMouseRightButtonDown"
                      ContextMenuOpening="CultureTree_ContextMenuOpening">
                <TreeView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource CulturesTab_CtxCopy}"
                                  Click="CtxCopyCulture_Click"/>
                        <MenuItem x:Name="CtxEditMenuItem" Header="{DynamicResource CulturesTab_CtxEdit}"
                                  Click="CtxEditCulture_Click"/>
                    </ContextMenu>
                </TreeView.ContextMenu>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Cultures}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ModCount, StringFormat=' ({0} mod)'}" 
                                       Foreground="Gray" Margin="5,0,0,0"/>
                        </StackPanel>
                        <HierarchicalDataTemplate.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" Foreground="{Binding SourceBrush}"/>
                                    <TextBlock Text="{Binding Source, StringFormat=' ({0})'}" 
                                               Foreground="Gray" Margin="3,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </HierarchicalDataTemplate.ItemTemplate>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <Grid Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <GroupBox Header="{DynamicResource CulturesTab_Details}" Margin="0,0,0,10"
                      Visibility="Collapsed" x:Name="DetailGroup">
                <StackPanel>
                    <Label Content="{DynamicResource CulturesTab_Source}" FontWeight="Bold" />
                    <TextBlock x:Name="DetailSourceValue" Margin="15,0,0,5" />
                    <Label Content="{DynamicResource CulturesTab_CultureName}" FontWeight="Bold" />
                    <TextBlock x:Name="DetailNameValue" Margin="15,0,0,5" />
                    <Label Content="{DynamicResource CulturesTab_Color}" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="15,0,0,5">
                        <Border x:Name="DetailColorSwatch" Width="20" Height="20"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                CornerRadius="2" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DetailColorValue" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="DetailColorInternalText" Margin="15,0,0,5"
                               Text="{DynamicResource CulturesTab_ColorInternal}"
                               TextWrapping="Wrap" Foreground="Gray"
                               Visibility="Collapsed"/>
                    <Label Content="{DynamicResource CulturesTab_Ethos}" FontWeight="Bold" />
                    <TextBlock x:Name="DetailEthosValue" Margin="15,0,0,5" />
                    <Expander x:Name="DetailEthosExpander" Margin="15,0,0,5"
                              Header="{DynamicResource CulturesTab_EthosParameters}"
                              Visibility="Collapsed">
                        <ItemsControl x:Name="EthosParametersList" Margin="0,4,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Key}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="Gray"
                                                       FontStyle="Italic" TextWrapping="Wrap" Margin="4,2,4,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Content}" FontFamily="Consolas"
                                                       TextWrapping="Wrap" Margin="4"/>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Label Content="{DynamicResource CulturesTab_Heritage}" FontWeight="Bold" />
                    <TextBlock x:Name="DetailHeritageValue" Margin="15,0,0,5" />
                    <Expander x:Name="DetailHeritageExpander" Margin="15,0,0,5"
                              Header="{DynamicResource CulturesTab_HeritageParameters}"
                              Visibility="Collapsed">
                        <ItemsControl x:Name="HeritageParametersList" Margin="0,4,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Key}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="Gray"
                                                       FontStyle="Italic" TextWrapping="Wrap" Margin="4,2,4,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Content}" FontFamily="Consolas"
                                                       TextWrapping="Wrap" Margin="4"/>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Label Content="{DynamicResource CulturesTab_Language}" FontWeight="Bold" />
                    <TextBlock x:Name="DetailLanguageValue" Margin="15,0,0,5" />
                    <Expander x:Name="DetailLanguageExpander" Margin="15,0,0,5"
                              Header="{DynamicResource CulturesTab_LanguageParameters}"
                              Visibility="Collapsed">
                        <ItemsControl x:Name="LanguageParametersList" Margin="0,4,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Key}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="Gray"
                                                       FontStyle="Italic" TextWrapping="Wrap" Margin="4,2,4,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Content}" FontFamily="Consolas"
                                                       TextWrapping="Wrap" Margin="4"/>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Label Content="{DynamicResource CulturesTab_MartialCustom}" FontWeight="Bold" />
                    <TextBlock x:Name="DetailMartialCustomValue" Margin="15,0,0,5" />
                    <Expander x:Name="DetailMartialCustomExpander" Margin="15,0,0,5"
                              Header="{DynamicResource CulturesTab_MartialCustomParameters}"
                              Visibility="Collapsed">
                        <ItemsControl x:Name="MartialCustomParametersList" Margin="0,4,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Key}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="Gray"
                                                       FontStyle="Italic" TextWrapping="Wrap" Margin="4,2,4,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Content}" FontFamily="Consolas"
                                                       TextWrapping="Wrap" Margin="4"/>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Label Content="{DynamicResource CulturesTab_HeadDetermination}" FontWeight="Bold" />
                    <TextBlock x:Name="DetailHeadDeterminationValue" Margin="15,0,0,5" />
                    <Expander x:Name="DetailHeadDeterminationExpander" Margin="15,0,0,5"
                              Header="{DynamicResource CulturesTab_HeadDeterminationParameters}"
                              Visibility="Collapsed">
                        <ItemsControl x:Name="HeadDeterminationParametersList" Margin="0,4,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding Key}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="Gray"
                                                       FontStyle="Italic" TextWrapping="Wrap" Margin="4,2,4,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Content}" FontFamily="Consolas"
                                                       TextWrapping="Wrap" Margin="4"/>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Label Content="{DynamicResource CulturesTab_Traditions}" FontWeight="Bold" />
                    <Expander x:Name="DetailTraditionsExpander" Margin="15,0,0,5"
                              Header="{DynamicResource CulturesTab_TraditionsParameters}"
                              Visibility="Collapsed">
                        <ItemsControl x:Name="TraditionsList" Margin="0,4,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding DisplayName}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="Gray"
                                                       FontStyle="Italic" TextWrapping="Wrap" Margin="4,2,4,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Expander Header="{Binding Key}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Description}" Foreground="Gray"
                                                                           FontStyle="Italic" TextWrapping="Wrap" Margin="4,2,4,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Content}" FontFamily="Consolas"
                                                                           TextWrapping="Wrap" Margin="4"/>
                                                            </StackPanel>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Label Content="{DynamicResource CulturesTab_NameList}" FontWeight="Bold" />
                    <TextBlock x:Name="DetailNameListValue" Margin="15,0,0,5" />
<Expander x:Name="DetailNameListExpander" Margin="15,0,0,5"
                              Header="{DynamicResource CulturesTab_NameListParameters}"
                              Visibility="Collapsed">
                        <ItemsControl x:Name="NameListParametersList" Margin="0,4,0,4">
                            <ItemsControl.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <Expander Header="{Binding Name}" IsExpanded="True" FontWeight="Bold">
                                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Expander Header="{Binding Key}">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Description}" Foreground="Gray"
                                                                               FontStyle="Italic" TextWrapping="Wrap" Margin="4,2,4,0">
                                                                         <TextBlock.Style>
                                                                             <Style TargetType="TextBlock">
                                                                                 <Setter Property="Visibility" Value="Collapsed"/>
                                                                                 <Style.Triggers>
                                                                                     <DataTrigger Binding="{Binding HasDescription}" Value="True">
                                                                                         <Setter Property="Visibility" Value="Visible"/>
                                                                                     </DataTrigger>
                                                                                 </Style.Triggers>
                                                                             </Style>
                                                                         </TextBlock.Style>
                                                                     </TextBlock>
                                                                     <TextBlock Text="{Binding Content}" FontFamily="Consolas"
                                                                                TextWrapping="Wrap" Margin="4"/>
                                                                </StackPanel>
                                                            </Expander>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                    </Expander>

                    <Label Content="{DynamicResource CulturesTab_Gfx}" FontWeight="Bold" />
                    <Expander x:Name="DetailGfxExpander" Margin="15,0,0,5"
                              Header="{DynamicResource CulturesTab_GfxParameters}"
                              Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="DetailGfxInfo" Margin="15,0,0,5"
                                       Text="{DynamicResource CulturesTab_GfxInfo}"
                                       TextWrapping="Wrap" Foreground="Gray"/>
                            <Label Content="{DynamicResource CulturesTab_CoaGfx}" FontWeight="Bold" />
                            <TextBlock x:Name="DetailCoaGfxValue" Margin="15,0,0,5" />
                            <Border x:Name="CoaGfxViewportBorder" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                    CornerRadius="2" Margin="15,5,0,5" Height="220" Visibility="Collapsed">
                                <Viewport3D x:Name="CoaGfxViewport3D"/>
                            </Border>
                            <Expander x:Name="BuildingExpander" Margin="15,0,0,5" IsExpanded="False"
                                      Header="{DynamicResource CulturesTab_BuildingGfx}"
                                      Expanded="ModelExpander_Expanded" Collapsed="ModelExpander_Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="DetailBuildingGfxValue" Margin="15,4,0,5" />
                                    <TextBlock Margin="15,0,0,5" Text="{DynamicResource CulturesTab_BuildingGfxHint}"
                                               TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="BuildingGfxLoading" Margin="15,6,0,6"
                                               Text="{DynamicResource CulturesTab_Loading}"
                                               Foreground="Gray" FontStyle="Italic" Visibility="Collapsed"/>
                                    <Border x:Name="BuildingGfxGridHost" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                            CornerRadius="2" Margin="15,5,0,5" Padding="4" Visibility="Collapsed">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                                            <WrapPanel x:Name="BuildingGfxGrid" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="ClothingExp" Margin="15,0,0,5" IsExpanded="False"
                                      Header="{DynamicResource CulturesTab_ClothingGfx}"
                                      Expanded="ModelExpander_Expanded" Collapsed="ModelExpander_Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="DetailClothingGfxValue" Margin="15,4,0,5" />
                                    <TextBlock Margin="15,0,0,5" Text="{DynamicResource CulturesTab_ClothingGfxHint}"
                                               TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="ClothingGfxLoading" Margin="15,0,0,5"
                                               Text="{DynamicResource CulturesTab_Loading}" Foreground="Gray" FontStyle="Italic" Visibility="Collapsed"/>
                                    <Border x:Name="ClothingGfxGridHost" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                            CornerRadius="2" Margin="15,5,0,5" Padding="4" Visibility="Collapsed">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                                            <WrapPanel x:Name="ClothingGfxGrid" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="UnitExp" Margin="15,0,0,5" IsExpanded="False"
                                      Header="{DynamicResource CulturesTab_UnitGfx}"
                                      Expanded="ModelExpander_Expanded" Collapsed="ModelExpander_Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="DetailUnitGfxValue" Margin="15,4,0,5" />
                                    <TextBlock Margin="15,0,0,5" Text="{DynamicResource CulturesTab_UnitGfxHint}"
                                               TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
                                    <TextBlock x:Name="UnitGfxLoading" Margin="15,0,0,5"
                                               Text="{DynamicResource CulturesTab_Loading}" Foreground="Gray" FontStyle="Italic" Visibility="Collapsed"/>
                                    <Border x:Name="UnitGfxGridHost" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                            CornerRadius="2" Margin="15,5,0,5" Padding="4" Visibility="Collapsed">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="360">
                                            <WrapPanel x:Name="UnitGfxGrid" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Expander>
                            <Label Content="{DynamicResource CulturesTab_HouseCoaFrame}" FontWeight="Bold" />
                            <TextBlock x:Name="DetailHouseCoaFrameValue" Margin="15,0,0,5" />
                            <Label Content="{DynamicResource CulturesTab_DynastyCoaFrame}" FontWeight="Bold" />
                            <TextBlock x:Name="DetailDynastyCoaFrameValue" Margin="15,0,0,5" />
                            <Label Content="{DynamicResource CulturesTab_HouseCoaMaskOffset}" FontWeight="Bold" />
                            <TextBlock x:Name="DetailHouseCoaMaskOffsetValue" Margin="15,0,0,5" />
                            <Label Content="{DynamicResource CulturesTab_HouseCoaMaskScale}" FontWeight="Bold" />
                            <TextBlock x:Name="DetailHouseCoaMaskScaleValue" Margin="15,0,0,5" />
                        </StackPanel>
                    </Expander>
                    <Label Content="{DynamicResource CulturesTab_Ethnicities}" FontWeight="Bold" Margin="0,10,0,0" />
                    <TextBlock x:Name="DetailEthnicitiesValue" Margin="15,0,0,5"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <TextBlock x:Name="DetailEmptyText"
                       Text="{DynamicResource CulturesTab_SelectPrompt}" 
                       TextWrapping="Wrap" Foreground="Gray"
                       Margin="0,10,0,0"/>
            </StackPanel>
            </ScrollViewer>

            <GroupBox Grid.Row="0" Header="{DynamicResource CulturesTab_Stats}" x:Name="StatsGroup">
                <StackPanel>
                    <TextBlock x:Name="StatsGroupsText"/>
                    <TextBlock x:Name="StatsModGroupsText" Margin="0,3,0,0"/>
                    <TextBlock x:Name="StatsModCulturesText" Margin="0,3,0,0"/>
                    <TextBlock x:Name="StatsBaseCulturesText" Margin="0,3,0,0"/>
                    <Separator Margin="0,6,0,4"/>
                    <TextBlock Margin="0,0,0,2">
                        <TextBlock.Inlines>
                            <Run Text="■ " Foreground="Black"/><Run Text="{DynamicResource CulturesTab_LegendBase}"/>
                        </TextBlock.Inlines>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,2">
                        <TextBlock.Inlines>
                            <Run Text="■ " Foreground="#0078D4"/><Run Text="{DynamicResource CulturesTab_LegendMod}"/>
                        </TextBlock.Inlines>
                    </TextBlock>
                    <TextBlock Margin="0,0,0,2">
                        <TextBlock.Inlines>
                            <Run Text="■ " Foreground="#008C00"/><Run Text="{DynamicResource CulturesTab_LegendModNew}"/>
                        </TextBlock.Inlines>
                    </TextBlock>
                </StackPanel>
            </GroupBox>
        </Grid>
        </Grid>
        </TabItem>

        <TabItem x:Name="EditorTabItem">
            <TabItem.Header>
                <TextBlock x:Name="EditorTabHeaderText"/>
            </TabItem.Header>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <TextBlock x:Name="EditorModeText" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="EditorHintText" Foreground="Gray" TextWrapping="Wrap" Margin="0,4,0,10"/>

                <GroupBox>
                    <StackPanel>
                        <StackPanel x:Name="EditorIdRow">
                            <Label x:Name="EditorIdLabel" Content="{DynamicResource CulturesTab_EditorCultureId}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                            <TextBox x:Name="EditorCultureId" Width="350" MaxLength="50" HorizontalAlignment="Left" Margin="15,0,0,4" TextChanged="EditorCultureId_TextChanged"/>
                        </StackPanel>
                        <Label x:Name="EditorColorLabel" Content="{DynamicResource CulturesTab_EditorColor}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                        <StackPanel Orientation="Horizontal" Margin="15,0,0,4">
                            <Border x:Name="EditorColorPreview" Width="40" Height="24" Background="White" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" VerticalAlignment="Center"/>
                            <Button x:Name="EditorColorButton" Content="{DynamicResource CulturesTab_EditorChooseColor}" Width="150" Margin="8,0,0,0" Click="EditorColor_Click"/>
                        </StackPanel>
                        <Label x:Name="EditorEthosLabel" Content="{DynamicResource CulturesTab_EditorEthos}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                        <ComboBox x:Name="EditorEthos" MaxWidth="500" HorizontalAlignment="Left" Margin="15,0,0,4" SelectionChanged="EditorField_SelectionChanged"/>
                        <Label x:Name="EditorHeritageLabel" Content="{DynamicResource CulturesTab_EditorHeritage}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                        <ComboBox x:Name="EditorHeritage" MaxWidth="500" HorizontalAlignment="Left" Margin="15,0,0,4" SelectionChanged="EditorField_SelectionChanged"/>
                        <Label x:Name="EditorLanguageLabel" Content="{DynamicResource CulturesTab_EditorLanguage}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                        <ComboBox x:Name="EditorLanguage" MaxWidth="500" HorizontalAlignment="Left" Margin="15,0,0,4" SelectionChanged="EditorField_SelectionChanged"/>
                        <Label x:Name="EditorMartialCustomLabel" Content="{DynamicResource CulturesTab_EditorMartialCustom}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                        <ComboBox x:Name="EditorMartialCustom" MaxWidth="500" HorizontalAlignment="Left" Margin="15,0,0,4" SelectionChanged="EditorField_SelectionChanged"/>
                        <Label x:Name="EditorHeadDeterminationLabel" Content="{DynamicResource CulturesTab_EditorHeadDetermination}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                        <ComboBox x:Name="EditorHeadDetermination" MaxWidth="500" HorizontalAlignment="Left" Margin="15,0,0,4" SelectionChanged="EditorField_SelectionChanged"/>
                        <Label x:Name="EditorTraditionsLabel" Content="{DynamicResource CulturesTab_EditorTraditions}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                        <Grid Margin="15,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource CulturesTab_EditorTraditionsSelected}" Foreground="Gray" Margin="0,0,0,2"/>
                                <ListBox x:Name="EditorTraditionsSelected" SelectionMode="Single" Margin="0,0,6,0" MaxHeight="200"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource CulturesTab_EditorTraditionsAvailable}" Foreground="Gray" Margin="6,0,0,2"/>
                                <ListBox x:Name="EditorTraditionsAvailable" SelectionMode="Single" Margin="6,0,0,0" MaxHeight="200"/>
                            </DockPanel>
                        </Grid>
                        <Label x:Name="EditorNameListLabel" Content="{DynamicResource CulturesTab_EditorNameList}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                        <ComboBox x:Name="EditorNameList" MaxWidth="500" HorizontalAlignment="Left" Margin="15,0,0,4" SelectionChanged="EditorField_SelectionChanged"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="{DynamicResource CulturesTab_EditorDetails}" Margin="0,10,0,0">
                    <StackPanel>
                        <Label x:Name="EditorCoaGfxLabel" Content="{DynamicResource CulturesTab_EditorCoaGfx}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                        <Grid Margin="15,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource CulturesTab_EditorGfxSelected}" Foreground="Gray" Margin="0,0,0,2"/>
                                <ListBox x:Name="EditorCoaGfxSelected" SelectionMode="Single" Margin="0,0,6,0" MaxHeight="150"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource CulturesTab_EditorGfxAvailable}" Foreground="Gray" Margin="6,0,0,2"/>
                                <ListBox x:Name="EditorCoaGfxAvailable" SelectionMode="Single" Margin="6,0,0,0" MaxHeight="150"/>
                            </DockPanel>
                        </Grid>
                        <Label x:Name="EditorBuildingGfxLabel" Content="{DynamicResource CulturesTab_EditorBuildingGfx}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                        <Grid Margin="15,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource CulturesTab_EditorGfxSelected}" Foreground="Gray" Margin="0,0,0,2"/>
                                <ListBox x:Name="EditorBuildingGfxSelected" SelectionMode="Single" Margin="0,0,6,0" MaxHeight="150"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource CulturesTab_EditorGfxAvailable}" Foreground="Gray" Margin="6,0,0,2"/>
                                <ListBox x:Name="EditorBuildingGfxAvailable" SelectionMode="Single" Margin="6,0,0,0" MaxHeight="150"/>
                            </DockPanel>
                        </Grid>
                        <Label x:Name="EditorClothingGfxLabel" Content="{DynamicResource CulturesTab_EditorClothingGfx}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                        <Grid Margin="15,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource CulturesTab_EditorGfxSelected}" Foreground="Gray" Margin="0,0,0,2"/>
                                <ListBox x:Name="EditorClothingGfxSelected" SelectionMode="Single" Margin="0,0,6,0" MaxHeight="150"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource CulturesTab_EditorGfxAvailable}" Foreground="Gray" Margin="6,0,0,2"/>
                                <ListBox x:Name="EditorClothingGfxAvailable" SelectionMode="Single" Margin="6,0,0,0" MaxHeight="150"/>
                            </DockPanel>
                        </Grid>
                        <Label x:Name="EditorUnitGfxLabel" Content="{DynamicResource CulturesTab_EditorUnitGfx}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                        <Grid Margin="15,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0">
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource CulturesTab_EditorGfxSelected}" Foreground="Gray" Margin="0,0,0,2"/>
                                <ListBox x:Name="EditorUnitGfxSelected" SelectionMode="Single" Margin="0,0,6,0" MaxHeight="150"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1">
                                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource CulturesTab_EditorGfxAvailable}" Foreground="Gray" Margin="6,0,0,2"/>
                                <ListBox x:Name="EditorUnitGfxAvailable" SelectionMode="Single" Margin="6,0,0,0" MaxHeight="150"/>
                            </DockPanel>
                        </Grid>
                        <Label x:Name="EditorHouseCoaLabel" Content="{DynamicResource CulturesTab_EditorHouseCoaFrame}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                        <ComboBox x:Name="EditorHouseCoaFrame" MaxWidth="500" HorizontalAlignment="Left" Margin="15,0,0,4" SelectionChanged="EditorField_SelectionChanged"/>
                        <TextBlock x:Name="EditorHouseCoaMaskText" Foreground="Gray" Margin="15,0,0,4" TextWrapping="Wrap"/>
                        <Label x:Name="EditorEthnicitiesLabel" Content="{DynamicResource CulturesTab_EditorEthnicities}" FontWeight="Bold" Style="{StaticResource ModifiedEditorLabel}" Tag="False"/>
                        <ItemsControl x:Name="EditorEthnicitiesRows" Margin="15,4,0,4"/>
                        <Button x:Name="EditorEthnicityAddButton" Content="{DynamicResource CulturesTab_EditorEthnicityAdd}" Margin="15,0,0,4" HorizontalAlignment="Left" Padding="12,3" Click="EditorEthnicityAdd_Click"/>
                    </StackPanel>
                </GroupBox>

                <StackPanel x:Name="EditorTargetRow" Orientation="Horizontal" Margin="0,10,0,0"
                            VerticalAlignment="Center">
                    <Button Content="{DynamicResource CulturesTab_EditorBrowseFolder}" Width="150"
                            Click="EditorBrowseFolder_Click" Margin="0,0,10,0"/>
                    <TextBlock x:Name="EditorTargetFolderText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                </StackPanel>
                <StackPanel x:Name="EditorFileNameRow" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                    <Label Content="{DynamicResource CulturesTab_EditorFileName}" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBox x:Name="EditorFileName" Width="250" VerticalAlignment="Center"
                             TextChanged="EditorFileName_TextChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="EditorSaveButton" Content="{DynamicResource CulturesTab_EditorSave}"
                            Width="120" MinHeight="26" Padding="0,4,0,4" Click="EditorSave_Click" Margin="0,0,10,0"/>
                    <Button x:Name="EditorClearButton" Content="{DynamicResource CulturesTab_EditorClear}"
                            Width="120" MinHeight="26" Padding="0,4,0,4" Click="EditorClear_Click"/>
                </StackPanel>

                <TextBlock x:Name="EditorStatusText" Foreground="Gray" Margin="0,10,0,20"
                           TextWrapping="Wrap"/>
            </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
